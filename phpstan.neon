parameters:
    level: 5

    # Scan only src/ (skip lib/ which contains early-error handlers with
    # intentionally non-standard PHP for bootstrap resilience).
    paths:
        - src/

    # WordPress stubs — lets PHPStan recognize WP core functions/classes
    # without requiring a full WordPress installation in CI.
    # Run `composer install` first to download stubs.
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

    # Baseline locks in existing errors so new code cannot add more.
    # Regenerate with: vendor/bin/phpstan analyse --generate-baseline=phpstan-baseline.php
    baselineFile: phpstan-baseline.php

    # WordPress globals — exclude from undefined variable checks.
    universalObjectCratesClasses:
        - WP_Post
        - WP_Term
        - WP_User
        - WP_Query

    # Ignore WordPress-specific error patterns that are false positives
    # for plugin code (e.g. direct $_POST access is intentional in AJAX handlers).
    ignoreErrors:
        - '#Access to an undefined property WP_Post::\$#'
        - '#Function .* not found#'

    # Exclude test fixtures and early-error handlers from analysis.
    excludePaths:
        - lib/*
        - tests/*
        - admin/views/*

    # Treat mixed as a valid type (WordPress returns mixed from many APIs).
    checkGenericClassInNonGenericObjectType: false
    checkMissingVarAnnotation: false
    checkUninitializedProperties: false
